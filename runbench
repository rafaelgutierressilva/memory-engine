#!/usr/bin/env bash
# ALIAS DE COMPATIBILIDADE — `runbench` virou `lembra bench`.
# Mantido para nao quebrar dedo-memoria e scripts antigos.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
echo "aviso: \`runbench\` agora e \`lembra bench\` (este alias segue funcionando)" >&2
exec "$DIR/bin/lembra" bench "$@"
