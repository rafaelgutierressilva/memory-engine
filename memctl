#!/usr/bin/env bash
# ALIAS DE COMPATIBILIDADE — `memctl` virou `lembra `.
# Mantido para nao quebrar dedo-memoria e scripts antigos.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
echo "aviso: \`memctl\` agora e \`lembra\` (este alias segue funcionando)" >&2
exec "$DIR/bin/lembra"  "$@"
