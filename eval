#!/usr/bin/env bash
# ALIAS DE COMPATIBILIDADE — `eval` virou `lembra eval`.
# Mantido para nao quebrar dedo-memoria e scripts antigos.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
echo "aviso: \`eval\` agora e \`lembra eval\` (este alias segue funcionando)" >&2
exec "$DIR/bin/lembra" eval "$@"
