#!/usr/bin/env bash
# ALIAS DE COMPATIBILIDADE — `chat` virou `lembra chat`.
# Mantido para nao quebrar dedo-memoria e scripts antigos.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
echo "aviso: \`chat\` agora e \`lembra chat\` (este alias segue funcionando)" >&2
exec "$DIR/bin/lembra" chat "$@"
